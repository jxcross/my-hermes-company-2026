# Solomon Hermes 인스턴스 환경변수 예시
# 이 파일을 복사해서 .env 로 만들고 값을 채운다:  cp .env.example .env
# .env 는 절대 커밋하지 않는다(.gitignore 처리됨).

# ── LLM 제공자 키 (최소 1개) ─────────────────────────────
# Solomon 기본 권장: Anthropic Claude (기획·검증·보고 품질)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ── Slack (Socket Mode) ─────────────────────────────────
# Sam이 Slack 앱 생성 후 발급 (docs/05_stage0_setup_guide.md 단계 0-D 참고)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_ALLOWED_USERS=          # Sam의 Slack member ID (예: U01ABC2DEF3)
SLACK_HOME_CHANNEL=           # #mission-log 채널 ID (예: C0123456789)

# ── 웹 대시보드(게시판) basic auth (권장) ────────────────
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me

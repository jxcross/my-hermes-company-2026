# Solomon Hermes 인스턴스 환경변수 예시
# 이 파일을 복사해서 .env 로 만들고 값을 채운다:  cp .env.example .env
# .env 는 절대 커밋하지 않는다(.gitignore 처리됨).

# ── LLM 인증 ─────────────────────────────────────────────
# Solomon 등 기본 모델: OAuth 방식(ChatGPT 구독) GPT-5.5 (provider: openai-codex)
#   → API 키 대신 `hermes setup`(또는 `hermes login`)으로 OAuth 로그인.
#   → 인증정보는 hermes-home/auth.json 에 저장(커밋 금지, gitignore).
# (선택) API 키 방식을 쓸 경우에만 아래 주석 해제:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ── Slack (Socket Mode) ─────────────────────────────────
# Sam이 Slack 앱 생성 후 발급 (docs/05_stage0_setup_guide.md 단계 0-D 참고)
# ⚠️ 값 뒤에 인라인 주석(# ...)을 붙이지 말 것 — docker compose가 값의 일부로 읽는다.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Sam의 Slack member ID (예: U01ABC2DEF3)
SLACK_ALLOWED_USERS=
# #mission-log 채널 ID (예: C0123456789)
SLACK_HOME_CHANNEL=

# ── Discord (Slack 과 **병렬** — 둘 다 항상 게시) ─────────
# 회사망에서 slack.com 이 막힐 때의 실제 경로. 실측 2026-08-06:
#   discord.com 200(0.06s) · slack.com 타임아웃
# 설정 절차는 docs/17_discord_setup_runbook.md (15~20분, Sam 수동).
# ⚠️ 값 뒤에 인라인 주석(# ...)을 붙이지 말 것 — docker compose가 값의 일부로 읽는다.
# ⚠️ 토큰 하나면 Hermes 가 Discord 를 자동 활성화한다(Slack 과 달리 App Token 불필요).
# ⚠️ Developer Portal 에서 **MESSAGE CONTENT INTENT 를 켜라** — 끄면 봇이 메시지 내용을
#    못 읽고 **에러 없이 침묵한다**(승인이 영영 감지되지 않는다).
DISCORD_BOT_TOKEN=
# Sam의 Discord user ID (숫자 19자리). 개발자 모드 ON 후 우클릭 → 사용자 ID 복사.
# ⚠️ **숫자 ID 를 써라.** username 을 쓰면 어댑터가 SERVER MEMBERS INTENT 를 추가로 요구한다.
DISCORD_ALLOWED_USERS=
# ⚠️ **fail-closed**: 아래를 비워 두면 Discord 봇이 모든 메시지를 조용히 거부한다.
#    채널 ID 3개(ceo-office, mission-log, approvals)를 콤마로.
DISCORD_ALLOWED_CHANNELS=
# #mission-log 채널 ID (통지 홈)
DISCORD_HOME_CHANNEL=

# ── 게이트키퍼 Discord 경로 ──
# #approvals 채널 ID. **비우면 Discord 승인 폴링이 비활성**(fail-closed — Slack 채널 ID 를
# 재사용할 수 없고, 틀린 채널에 올리면 승인이 조용히 사라진다).
GATE_KEEPER_DISCORD_APPROVALS_CHANNEL=
# 게이트 이벤트 통지 대상. 채널 **ID** 를 권장(이름 해석은 게이트웨이에 의존할 수 있다).
# 예: discord:1401234567890123456
GATE_KEEPER_DISCORD=
# (선택) 승인 권한자를 대화 허용자와 분리하고 싶을 때. 미설정 시 DISCORD_ALLOWED_USERS.
# GATE_KEEPER_DISCORD_ALLOWED_USERS=

# ── GitHub (Deliver 단계의 컨테이너 git push 자격) ────────
# Deliver가 컨테이너 내부에서 origin push 하려면 필요(없으면 self-block→호스트 폴백).
# Fine-grained PAT: 이 repo Contents=Read/Write. 또는 classic PAT: repo scope.
# docker-compose가 이 값을 credential helper(GIT_CONFIG_*)로 github.com HTTPS 인증에 사용.
# ⚠️ 값 뒤 인라인 주석 금지.
GITHUB_TOKEN=

# ── 웹 대시보드(게시판) basic auth (권장) ────────────────
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me

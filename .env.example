# Solomon Hermes 인스턴스 환경변수 예시
# 이 파일을 복사해서 .env 로 만들고 값을 채운다:  cp .env.example .env
# .env 는 절대 커밋하지 않는다(.gitignore 처리됨).

# ── LLM 인증 ─────────────────────────────────────────────
# Solomon 등 기본 모델: OAuth 방식(ChatGPT 구독) GPT-5.5 (provider: openai-codex)
#   → API 키 대신 `hermes setup`(또는 `hermes login`)으로 OAuth 로그인.
#   → 인증정보는 hermes-home/auth.json 에 저장(커밋 금지, gitignore).
# (선택) API 키 방식을 쓸 경우에만 아래 주석 해제:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ── Slack (Socket Mode) ─────────────────────────────────
# Sam이 Slack 앱 생성 후 발급 (docs/05_stage0_setup_guide.md 단계 0-D 참고)
# ⚠️ 값 뒤에 인라인 주석(# ...)을 붙이지 말 것 — docker compose가 값의 일부로 읽는다.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Sam의 Slack member ID (예: U01ABC2DEF3)
SLACK_ALLOWED_USERS=
# #mission-log 채널 ID (예: C0123456789)
SLACK_HOME_CHANNEL=

# ── GitHub (Deliver 단계의 컨테이너 git push 자격) ────────
# Deliver가 컨테이너 내부에서 origin push 하려면 필요(없으면 self-block→호스트 폴백).
# Fine-grained PAT: 이 repo Contents=Read/Write. 또는 classic PAT: repo scope.
# docker-compose가 이 값을 credential helper(GIT_CONFIG_*)로 github.com HTTPS 인증에 사용.
# ⚠️ 값 뒤 인라인 주석 금지.
GITHUB_TOKEN=

# ── 웹 대시보드(게시판) basic auth (권장) ────────────────
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
